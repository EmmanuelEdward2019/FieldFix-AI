# Copy to .env and adjust. Never commit real secrets.
NODE_ENV=development
PORT=3001
CORS_ORIGIN=http://localhost:3000
API_VERSION=0.1.0
# Local PostgreSQL (see docs/DATABASE.md). User defaults to your OS user.
DATABASE_URL=postgresql://127.0.0.1:5432/fieldfix_dev
DATABASE_URL_TEST=postgresql://127.0.0.1:5432/fieldfix_test
# Private object storage (local driver keeps bytes under STORAGE_DIR,
# default apps/api/.storage). Never served publicly; downloads go
# through an authorized API route.
STORAGE_DRIVER=local
STORAGE_DIR=/var/lib/fieldfix/storage
MAX_UPLOAD_MB=10
# Meta Model API (see docs/META_API_INTEGRATION.md). Key stays server-side.
META_API_KEY=
META_MODEL_ID=muse-spark-1.3
SAM_MODEL_ID=sam-3.1
META_API_BASE_URL=https://api.meta.ai/v1
META_REQUEST_TIMEOUT_MS=60000
META_MAX_RETRIES=3
META_REASONING_EFFORT=medium
# Covers reasoning + output tokens; 4000 truncates vision analyses.
META_MAX_OUTPUT_TOKENS=16000
META_MAX_IMAGES_PER_REQUEST=8
META_MAX_IMAGE_BYTES=10485760
Admin console access is role-based (user login sessions). Bootstrap: list the
emails to auto-promote to Super Admin on login, then assign further roles
from Admin > Users. Super Admins must enroll MFA before console access.
SUPER_ADMIN_EMAILS=owner@example.com
# TOTP secrets are AES-256-GCM encrypted with this key (32 bytes, 64 hex
# chars, e.g. `openssl rand -hex 32`). Unset = MFA enrollment unavailable.
MFA_ENCRYPTION_KEY=
# Email (Resend) for signup confirmation + password reset links.
# Unset = log-only mode: links print to the API console, nothing is sent.
RESEND_API_KEY=re_xxx
EMAIL_FROM=FieldFix AI <onboarding@resend.dev>
APP_BASE_URL=http://localhost:3000
iFixit connector base (default shown). Only used with IFIXIT_INGEST_ACK.
IFIXIT_API_BASE_URL=https://www.ifixit.com/api/2.0
# Licence acknowledgements for connectors (exact values; see docs/DATA_SOURCES.md).
# Set only after reviewing the upstream licence and terms.
MYFIXIT_LICENCE_ACK=CC-BY-NC-SA-3.0
IFIXIT_INGEST_ACK=CC-BY-NC-SA-3.0
