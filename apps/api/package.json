{
  "name": "@fieldfix/api",
  "version": "0.1.0",
  "private": true,
  "description": "FieldFix AI backend API (Express + TypeScript).",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "clean": "rm -rf dist",
    "db:migrate": "tsx src/db/migrate.ts up",
    "db:migrate:down": "tsx src/db/migrate.ts down",
    "db:seed": "tsx src/db/seed.ts",
    "predb:seed": "npm run build -w @fieldfix/contracts",
    "prebuild": "npm run build -w @fieldfix/contracts",
    "pretest": "npm run build -w @fieldfix/contracts",
    "pretypecheck": "npm run build -w @fieldfix/contracts",
    "predev": "npm run build -w @fieldfix/contracts"
  },
  "dependencies": {
    "@fieldfix/contracts": "*",
    "@meta-sam/parser": "^0.1.0",
    "@types/pdfkit": "^0.17.7",
    "cors": "^2.8.5",
    "csv-parse": "^7.0.3",
    "dotenv": "^17.2.1",
    "express": "^4.21.2",
    "helmet": "^8.1.0",
    "image-size": "^2.0.4",
    "kysely": "^0.29.7",
    "multer": "^2.5.0",
    "otplib": "^13.6.0",
    "pdfjs-dist": "^6.4.299",
    "pdfkit": "^0.20.2",
    "pg": "^8.23.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.18.0",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^6.0.2",
    "supertest": "^7.1.0",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
